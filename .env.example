# Copy to .env and edit as needed.
DATABASE_URL=sqlite:///forecast_arena.db
FLASK_PORT=6006

# Optional: enables the Tavily search provider. Get a key at https://tavily.com
# Leave unset to disable retrieval — everything else still works.
TAVILY_API_KEY=

# Optional: enables the NewsResearchAgent's LLM forecast. Without this, the
# agent falls back to a neutral 50/50 prior — no crashes, no errors.
# Legacy vars (still honored):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Provider-agnostic LLM layer (see llm/). All optional — if unset the
# app still runs; agents that need an LLM fall back to heuristics.
# Point LLM_API_BASE at ANY OpenAI-compatible endpoint (OpenAI,
# Azure OpenAI, local vLLM/Ollama, ...). LLM_* takes
# precedence over the legacy OPENAI_* vars.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=

# TLS for private endpoints — some deployments use internally-signed
# certs that certifi (openai SDK's default trust store) doesn't know
# about. The loader auto-detects the system CA bundle (/etc/ssl/certs/...
# etc). Override only if that's wrong:
LLM_CA_BUNDLE=
# INSECURE escape hatch for local sandboxing; leave unset in production:
LLM_SSL_VERIFY=true

# Optional: llm_providers.json (see llm_providers.example.json) can hold
# non-secret provider metadata (apiBase, model, apiKeyEnv) so different
# deploys reuse the same code with different providers.

# ---------------------------------------------------------------------
# Model routing layer (see llm/routing.py). Logical tiers map to
# concrete provider+model here — business logic never names a model.
# A tier with no *_MODEL set is "unconfigured": the router will not
# route to it silently. FAST/BALANCED/STRONG fall back to LLM_MODEL
# above when their own model is unset; LOCAL/SPECIALIST never do.
LLM_TIER_FAST_PROVIDER=
LLM_TIER_FAST_MODEL=
LLM_TIER_BALANCED_PROVIDER=
LLM_TIER_BALANCED_MODEL=
LLM_TIER_STRONG_PROVIDER=
LLM_TIER_STRONG_MODEL=
LLM_TIER_SPECIALIST_PROVIDER=
LLM_TIER_SPECIALIST_MODEL=
LLM_TIER_LOCAL_PROVIDER=
LLM_TIER_LOCAL_MODEL=

# Budgets (all optional; unset ⇒ unlimited). Token counts are per day.
LLM_BUDGET_DAILY_INPUT_TOKENS=
LLM_BUDGET_DAILY_OUTPUT_TOKENS=
LLM_BUDGET_DAILY_STRONG_TOKENS=
LLM_BUDGET_PER_MARKET_DAILY_TOKENS=
LLM_BUDGET_PER_BUNDLE_TOKENS=
# Bounded-work limits (safe integer defaults if unset).
LLM_MAX_RETRIES=2
LLM_MAX_ESCALATIONS=1
LLM_MAX_CONCURRENT_STRONG=4
